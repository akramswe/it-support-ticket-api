{
  "imports": {
    "postgres": "npm:postgres@3.4.7"
  },
  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-env --allow-net src/main.ts",
    "start": "deno run --allow-env --allow-net src/main.ts",
    "migrate": "deno run --allow-env --allow-net --allow-read scripts/migrate.ts",
    "test": "deno test tests/unit",
    "test:integration": "deno test --allow-env --allow-net tests/integration",
    "format": "deno fmt",
    "check": "deno lint && deno check src/main.ts scripts/migrate.ts tests/unit/app.test.ts tests/unit/validation.test.ts tests/integration/postgres_repository.test.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
